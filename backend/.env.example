# =====================================================================
# SYNAPSE Backend — Environment Template
# Copy to `.env` and fill values. NEVER commit the populated `.env`.
# =====================================================================

CI_ENVIRONMENT = development
app.baseURL    = 'http://localhost:8090/'
app.timezone   = 'Asia/Manila'

# ---------------------------------------------------------------------
# Database — synapse_zcode
# Charset/collation must be portable across MySQL 5.7+, MySQL 8.4 LTS,
# and MariaDB 10.4+. Use `utf8mb4_unicode_ci` (NOT `utf8mb4_0900_ai_ci`,
# which is MySQL 8 only).
#
# IMPORTANT: CodeIgniter's Database config exposes the collation under
# the array key `DBCollat` (not `collation`). The env-override lookup
# therefore uses `database.default.DBCollat`. Setting `database.default.collation`
# here is a no-op — keep both for clarity, but the framework reads
# `DBCollat` only.
# ---------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = synapse_zcode
database.default.username = root
database.default.password =
database.default.DBDriver  = MySQLi
database.default.DBPrefix =
database.default.port      = 3306
database.default.charset   = utf8mb4
database.default.DBCollat  = utf8mb4_unicode_ci
database.default.strictOn  = true
database.default.encrypt   = false

# ---------------------------------------------------------------------
# Security / Crypto
# ---------------------------------------------------------------------
# 32-byte (64 hex chars) key used for AES-256-GCM field-level encryption.
# Rotate by bumping COUNSELLING_KEY_VERSION, inserting the new version's
# key_ref into `counselling_key_versions`, and exposing the retired key
# under the referenced env var (e.g. COUNSELLING_KEY_V1).
#
# Version 2 (2026-10 audit G-8) binds each envelope to its row via AES-GCM
# AAD ("table|scope|tenant"). Adopt by setting COUNSELLING_KEY_V2 (same
# value as COUNSELLING_KEY keeps the material, fresh value also rotates it)
# and flipping COUNSELLING_KEY_VERSION=2. v1 rows stay decryptable.
COUNSELLING_KEY         = replace_with_64_hex_chars
COUNSELLING_KEY_VERSION = 1
# Historical keys (uncomment after a rotation):
# COUNSELLING_KEY_V1    = previous_64_hex_chars
# COUNSELLING_KEY_V2    = current_64_hex_chars_after_flipping_version_to_2

# TOTP MFA secrets (local admin accounts only — the MIS path is never
# MFA-gated). Boot.php requires a valid 64-hex MFA_KEY in production while
# MFA_ENFORCE_FOR_PRIVILEGED is on; set the flag to false only as a
# conscious decision to skip privileged second-factor enforcement.
MFA_KEY                     = replace_with_64_hex_chars
MFA_ENFORCE_FOR_PRIVILEGED  = true

# QR token HMAC key (never log; never commit). 32+ bytes recommended.
REFERRAL_HMAC_KEY       = replace_with_strong_random_string

# JWT — short-lived access tokens.
JWT_SECRET              = replace_with_strong_random_string
# Rotation overlap window (optional): while set, tokens signed with
# JWT_SECRET_NEXT also verify. Rotate: set NEXT → wait >= access TTL →
# promote NEXT to SECRET → unset. Validated to the same length rules.
# JWT_SECRET_NEXT      = next_strong_random_string
JWT_ALG                 = HS256
JWT_ACCESS_TTL_SECONDS  = 900
JWT_REFRESH_TTL_SECONDS = 2592000

# Dedicated HMAC key for refresh-token hashing (optional, 64 hex). Setting
# it lets JWT_SECRET rotate WITHOUT invalidating stored refresh hashes.
# Tokens minted before the switch are still located during the transition.
# REFRESH_HMAC_KEY     = replace_with_64_hex_chars

# Refresh token cookie attributes. Boot.php refuses insecure values in
# production (REFRESH_COOKIE_SECURE must be true, SameSite Strict).
REFRESH_COOKIE_NAME     = synapse_rt
REFRESH_COOKIE_SECURE   = true
REFRESH_COOKIE_HTTPONLY = true
REFRESH_COOKIE_SAMESITE = Strict
# Path scope: the cookie only ever needs to reach /api/v1/auth/* (login
# sets it, refresh reads it, logout clears it).
REFRESH_COOKIE_PATH     = /api/v1/auth

# ---------------------------------------------------------------------
# FU MIS API (university identity source, 2026-09 integration)
#
# Campus-WiFi-only: mis.foundationu.com is unreachable from outside the
# university network, and Synapse calls it strictly server-side. The
# API key must never ship to any client (SPA/mobile) or be committed.
#
# FUMIS_ENABLED is the dev/prod toggle (Boot.php enforces production
# posture on related settings; dev-only values above are fine locally):
#   false (default) — local email/password login + demo seeders; works
#                     off-campus (CI included).
#   true             — student/employee-number logins delegate to the
#                     MIS API (full delegation, JIT provisioning).
# Requires the Synapse backend host to be on the university network.
# ---------------------------------------------------------------------
FUMIS_ENABLED           = false
FUMIS_BASE_URL          = https://mis.foundationu.com/sandbox
FUMIS_API_KEY           = replace_with_mis_department_api_key
FUMIS_TIMEOUT_SECONDS   = 10
FUMIS_TOKEN_CACHE_SECONDS = 600

# ---------------------------------------------------------------------
# CORS — strict origin allowlist. No wildcards in prod.
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS = http://localhost:5173

# ---------------------------------------------------------------------
# Rate Limiting (fixed-window buckets per route group)
# ---------------------------------------------------------------------
RATELIMIT_GLOBAL_PER_MIN = 600
RATELIMIT_AUTH_PER_MIN   = 30
# ESP32 ingest surface — bucketed per device token (X-Device-Token).
RATELIMIT_DEVICE_PER_MIN = 120

# Carousel image upload cap in bytes (min 1 MB, max 50 MB; default 5 MB).
# upload_max_filesize remains the outer ceiling; this is the policy ceiling.
CAROUSEL_MAX_UPLOAD_BYTES = 5242880

# ---------------------------------------------------------------------
# BMG device fleet (mechanized tumbler ESP32s)
# ---------------------------------------------------------------------
# Heartbeat age at which a bound device is flagged offline (watchdog).
BMG_OFFLINE_AFTER_MIN    = 20
# Minutes after a scheduled slot before it counts as missed.
BMG_MISSED_RUN_GRACE_MIN = 30
# Pending outbound command lifetime — stale "run now" must not fire late.
BMG_COMMAND_TTL_MIN      = 10

# Per-account login lockout (Phase 6).
LOGIN_LOCKOUT_MAX_FAILURES   = 5
LOGIN_LOCKOUT_WINDOW_SECONDS = 900

# ---------------------------------------------------------------------
# Session (used by Shield fallback; API primary auth is JWT).
# ---------------------------------------------------------------------
session.driver   = CodeIgniter\Session\Handlers\FileHandler
session.cookieName = synapse_session
session.expiration = 7200
session.savePath = writable/session

# ---------------------------------------------------------------------
# Logging — must NEVER include payload, tokens, or clinical notes.
# ---------------------------------------------------------------------
logger.threshold = 4
