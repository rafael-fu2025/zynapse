{
    "name": "zcode/synapse-backend",
    "description": "SYNAPSE — CodeIgniter 4.7+ stateless REST API (modular monolith)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/shield": "^1.2",
        "firebase/php-jwt": "^6.10",
        "ramsey/uuid": "^4.7",
        "vlucas/phpdotenv": "^5.6",
        "predis/predis": "^2.2"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\Clinic\\": "app/Modules/Clinic/",
            "Modules\\Counselling\\": "app/Modules/Counselling/",
            "Modules\\Facilities\\": "app/Modules/Facilities/",
            "Modules\\Referrals\\": "app/Modules/Referrals/",
            "Modules\\Reports\\": "app/Modules/Reports/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
