<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Flutter edge-to-edge stays ENABLED (targetSdk 36): the app's own
             maroon NavigationBar paints down behind the transparent OS nav bar,
             which is reliable across OEMs (ColorOS ignores setNavigationBarColor
             and renders its own black/white strip otherwise). The maroon below
             is a harmless fallback for the brief splash/first-frame window. -->
        <item name="android:navigationBarColor">#800000</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Maroon window background. ColorOS keeps this window inset
             (content stops above the nav bar) and renders a TRANSPARENT OS
             nav bar once the native MainActivity disables contrast scrims, so
             the strip behind the OS nav bar shows this window background.
             Maroon here = maroon OS nav bar, matching the app's maroon
             NavigationBar directly above it. -->
        <item name="android:windowBackground">#800000</item>
        <!-- Edge-to-edge stays ENABLED (no opt-out); the app paints maroon
             behind the transparent OS nav bar (see LaunchTheme). -->
        <item name="android:navigationBarColor">#800000</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
