<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting
         (API 31+). Mirrors values/styles.xml LaunchTheme, plus the Android 12+
         SYSTEM splash screen attributes: by default Android 12+ shows the
         app's launcher icon on a background before Flutter draws; we point
         it at the SYNAPSE maroon crest on white instead so the splash is
         branded (matches the launch_background + Flutter "Restoring session…"
         screens) rather than flashing the launcher icon. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:navigationBarColor">#800000</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ system splash screen -->
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>
